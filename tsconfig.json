{
  "compilerOptions": {
    /* Language */
    "target": "ES2020",

    /* Node compatibility (NO .js imports in TS) */
    "module": "Node16",
    "moduleResolution": "Node16",

    /* Project structure */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Path alias */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    /* TS 6.x deprecation handling */
    // "ignoreDeprecations": "6.0",

    /* Type safety */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* Global types */
    "typeRoots": [
      "./src/types",
      "./node_modules/@types"
    ],

    /* Interop */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,

    /* Output */
    "sourceMap": true,
    "declaration": false,

    /* Performance */
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
